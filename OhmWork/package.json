{
	"name": "ohmwork",
	"private": true,
	"license": "GPL-2.0-or-later",
	"type": "module",
	"scripts": {
		"prepare": "git config core.hooksPath .githooks",
		"test": "vitest run && pnpm --filter @ohmwork/web test",
		"typecheck": "tsc -p tsconfig.base.json --noEmit && pnpm --filter @ohmwork/web build",
		"test:core": "vitest run",
		"test:e2e": "pnpm --filter @ohmwork/web test:e2e",
		"web": "pnpm --filter @ohmwork/web start",
		"desktop": "pnpm --filter @ohmwork/desktop dev",
		"desktop:build": "pnpm --filter @ohmwork/desktop build",
		"android": "pnpm --filter @ohmwork/desktop android:dev",
		"android:build": "pnpm --filter @ohmwork/desktop android:build"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
